FROM debian:13.1-slim AS build-gmp

WORKDIR /srv/gmp-4.3.2

RUN --mount=type=cache,target=/var/cache/apt,id=cache-apt-gmp \
    --mount=type=cache,target=/var/lib/apt,id=cache-apt-gmp \
    DEBIAN_FRONTEND=noninteractive apt update \
    && apt install wget vim xz-utils gcc-12 m4 make -y

RUN --mount=type=cache,target=/var/download,id=cache-download-gmp \
    [ -f /var/download/gmp.tar.gz ] || wget --no-verbose https://ftpmirror.gnu.org/gmp/gmp-4.3.2.tar.gz \
    -O /var/download/gmp.tar.gz \
    && tar -xf /var/download/gmp.tar.gz -C /srv/

RUN CC=gcc-12 \
    ./configure \
    --build=$(uname -m)-unknown-linux-gnu \
    --prefix /opt/gmp-4.3.2
RUN make -j$(nproc)
RUN make install

FROM debian:13.1-slim AS build-mpfr

WORKDIR /srv/mpfr-2.4.2

RUN --mount=type=cache,target=/var/cache/apt,id=cache-apt-mpfr \
    --mount=type=cache,target=/var/lib/apt,id=cache-apt-mpfr \
    DEBIAN_FRONTEND=noninteractive apt update \
    && apt install wget vim xz-utils gcc make -y

RUN --mount=type=cache,target=/var/download,id=cache-download-mpfr \
    [ -f /var/download/mpfr.tar.gz ] || wget --no-verbose https://ftpmirror.gnu.org/mpfr/mpfr-2.4.2.tar.gz \
    -O /var/download/mpfr.tar.gz \
    && tar -xf /var/download/mpfr.tar.gz -C /srv/

COPY --link --from=build-gmp /opt /opt

RUN ./configure \
    --build=$(uname -m)-unknown-linux-gnu \
    --prefix /opt/mpfr-2.4.2 \
    --with-gmp=/opt/gmp-4.3.2
RUN make -j$(nproc)
RUN make install


FROM debian:13.1-slim AS build-mpc

WORKDIR /srv/mpc-1.0.1

RUN --mount=type=cache,target=/var/cache/apt,id=cache-apt-mpc \
    --mount=type=cache,target=/var/lib/apt,id=cache-apt-mpc \
    DEBIAN_FRONTEND=noninteractive apt update \
    && apt install wget vim xz-utils gcc make -y

RUN --mount=type=cache,target=/var/download,id=cache-download-mpc \
    [ -f /var/download/mpc.tar.gz ] || wget --no-verbose https://ftpmirror.gnu.org/mpc/mpc-1.0.1.tar.gz \
    -O /var/download/mpc.tar.gz \
    && tar -xf /var/download/mpc.tar.gz -C /srv/

COPY --link --from=build-mpfr /opt /opt

RUN ./configure \
